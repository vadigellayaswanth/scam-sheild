# Scam Shield Environment Configuration Template
# Copy this file to '.env' and insert your personal API credentials.
# NEVER commit your actual '.env' file containing real secret keys to source control.

# Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model configuration (Default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Safe Browsing API Key (v4) for live threat-intelligence URL verification
# Obtain from Google Cloud Console: Enable 'Safe Browsing API' and create an API Key.
# When omitted, Scam Shield operates in heuristic, DNS, and SSRF-safe analysis mode without crashing.
SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key_here
